{
    "agent_servers": {
        "qwen-code": {
            "type": "registry"
        }
    },
    "tab_bar": {
        "show": true
    },
    "features": {
        "edit_prediction_provider": "zed"
    },
    "languages": {
        "Go": {
            "show_edit_predictions": true
        }
    },
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "claude-3.7-sonnet-thought"
        }
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "base_keymap": "Cursor",
    "theme": "Carbonfox - blurred",
    "vim_mode": true,
    "ui_font_size": 15,
    "buffer_font_size": 17,
    "ui_font_family": "FiraCode Nerd Font Mono",
    "buffer_font_family": "FiraCode Nerd Font Mono",
    "terminal": {
        "font_size": 15
    },
    "relative_line_numbers": "enabled",
    "vim": {
        "use_system_clipboard": "always"
    },
    "gutter": {
        "folds": true
    },
    "indent_guides": {
        "coloring": "indent_aware"
    },
    "context_servers": {
        "mcp-server-context7": {
            "enabled": true,
            "remote": false,
            "settings": {
                "context7_api_key": "ctx7sk-414bf341-c4a6-4337-8e4c-738554001450"
            }
        },
        "postgres-context-server": {
            "settings": {
                "database_url": "postgresql://postgres:postgres@localhost:5432/vulnsrv?sslmode=disable"
            }
        }
    }
}
